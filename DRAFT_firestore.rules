rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 255;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users shouldn't be listable by others
      
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(request.resource.data) &&
                      request.resource.data.createdAt == request.time;
                      
      allow update: if isSignedIn() && isOwner(userId) && isValidUser(request.resource.data) &&
                      request.resource.data.uid == resource.data.uid &&
                      request.resource.data.email == resource.data.email &&
                      request.resource.data.updatedAt == request.time;
    }
  }
}
